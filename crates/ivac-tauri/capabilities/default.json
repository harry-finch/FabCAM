{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled local frontend: native dialogs grant individual filesystem paths dynamically. No static home, documents or temporary-directory filesystem grants.",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-stat",
    "store:default",
    "log:default",
    "process:default",
    "opener:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists"
  ]
}
